{
  "name": "cntxt",
  "description": "Save the current window's tabs as a named workspace, close it, and restore it later.",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@cntxt/supabase": "workspace:*",
    "@cntxt/tokens": "workspace:*",
    "@cntxt/ui": "workspace:*",
    "@xstate/solid": "^2.0.0",
    "lucide-solid": "^1.48.0",
    "solid-js": "^1.9.11",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-solid": "^1.1.4",
    "daisyui": "^5.7.46",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
