{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/enyhma/cntxt.git",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", { "npmPublish": false, "pkgRoot": "extension" }],
    [
      "semantic-release-chrome",
      {
        "extensionId": "ehnhkcnmbkboaljolbndgdgfmjkgipih",
        "distFolder": "extension/.output/chrome-mv3",
        "asset": "extension/.output/cntxt-chrome.zip"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["extension/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "extension/.output/cntxt-chrome.zip",
            "label": "Chrome extension (.zip)"
          }
        ]
      }
    ]
  ]
}
