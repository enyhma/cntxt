---
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const DASHBOARD_URL = "https://dash.cntxt.work";
const prefix = home ? "" : "/";
---

<header class="site-header">
  <a href="/" class="brand">
    <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true">
      <path
        d="M 77.58 73.15 A 36 36 0 1 1 77.58 26.85"
        fill="none"
        stroke="var(--accent)"
        stroke-width="14"
        stroke-linecap="round"></path>
      <rect x="74" y="40" width="8" height="20" rx="4" fill="var(--accent)"
      ></rect>
    </svg>
    cntxt
  </a>
  <nav class="site-nav">
    <a href="/learn">Learn</a>
    <a href={`${prefix}#features`}>Features</a>
    <a href={`${prefix}#how-it-works`}>How it works</a>
    <a href="/pricing">Pricing</a>
    <a href={DASHBOARD_URL} class="btn btn-ghost">Dashboard</a>
    <button type="button" class="theme-toggle" aria-label="Switch theme">
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path>
      </svg>
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  (function () {
    function effectiveTheme() {
      var stamped = document.documentElement.dataset.theme;
      if (stamped === "light" || stamped === "dark") return stamped;
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    // JS-driven icon swap (not a :root CSS selector) because Astro scopes
    // this component's <style> block to its own elements, and :root
    // (the <html> element) falls outside that scope.
    function syncIcons() {
      var dark = effectiveTheme() === "dark";
      document.querySelectorAll(".theme-toggle").forEach(function (btn) {
        btn.querySelector(".icon-sun").style.display = dark ? "" : "none";
        btn.querySelector(".icon-moon").style.display = dark ? "none" : "";
      });
    }
    document.querySelectorAll(".theme-toggle").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var next = effectiveTheme() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        syncIcons();
      });
    });
    syncIcons();
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.5rem;
    background: color-mix(in srgb, var(--surface), transparent 8%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--surface-alt2);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 500;
    font-size: 1.05rem;
    text-decoration: none;
    color: inherit;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
  }
  .site-nav a:not(.btn) {
    color: var(--surface-txt-hint);
    text-decoration: none;
  }
  .site-nav a:not(.btn):hover {
    color: var(--surface-txt);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
  }
  .btn-ghost {
    border: 1px solid var(--surface-alt3);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--surface-alt3);
    border-radius: var(--radius);
    background: none;
    color: var(--surface-txt-hint);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--surface-txt);
  }

  @media (max-width: 720px) {
    .site-nav a:not(.btn) {
      display: none;
    }
  }
</style>
