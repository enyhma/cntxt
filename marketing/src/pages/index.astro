---
import SEO from "../components/SEO.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { requestWithMetadata } from "@tinacms/astro";
import { client } from "../../tina/__generated__/client";
import HomeContent from "../components/HomeContent.astro";

// Fetched through Tina's client (not a plain JSON import) so this page's
// render is wired into the same query the admin's live-preview bridge
// refreshes via /tina-island/home — see src/tina/islands.ts.
const result = await requestWithMetadata(
  client.queries.home({ relativePath: "home.json" }),
);
const home = result.data.home;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="cntxt — a Project for every window"
      description="cntxt turns every browser window into a named Project you can close and restore later — no more fifty pinned tabs across six windows."
      path="/"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "cntxt",
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome",
      description:
        "cntxt turns every browser window into a named Project you can close and restore later.",
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      window.$ujq = window.$ujq || [];
      window.uj =
        window.uj ||
        new Proxy(
          {},
          {
            get:
              (_, p) =>
              (...a) =>
                window.$ujq.push([p, ...a]),
          },
        );
      document.head.appendChild(
        Object.assign(document.createElement("script"), {
          src: "https://cdn.userjot.com/sdk/v2/uj.js",
          type: "module",
          async: true,
        }),
      );
      window.uj.init("cmulrcfq8009h0jnurgitgtvv", { widget: true });
    </script>
  </head>
  <body>
    <SiteHeader home />

    <main>
      <TinaIsland name="home" wrapper={{ tag: "div" }} primary>
        <HomeContent data={home} />
      </TinaIsland>

      <section class="cta">
        <h2>Stop losing tabs to closed windows.</h2>
        <a href="/pricing" class="btn btn-primary">See pricing</a>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style is:global>
  a {
    color: inherit;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: var(--shadow-raised);
  }
  .btn-primary:hover {
    background: var(--accent-alt1);
  }
  .btn-ghost {
    border: 1px solid var(--surface-alt3);
  }

  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero {
    text-align: center;
    padding: 6.5rem 0 4rem;
  }
  .eyebrow {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--surface-txt-hint);
    margin: 0 0 1.25rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    max-width: 18ch;
    margin: 0 auto;
  }
  .lede {
    max-width: 52ch;
    margin: 1.25rem auto 0;
    color: var(--surface-txt-hint);
    font-size: 1.05rem;
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-actions .btn[aria-disabled="true"] {
    opacity: 0.6;
    cursor: default;
  }
  .hero-subaction {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
  }
  .hero-subaction a {
    color: var(--surface-txt-hint);
    text-decoration: underline;
  }
  .mock-caption {
    margin: 0;
    padding: 0.5rem 0.9rem;
    border-top: 1px solid var(--surface-alt2);
    font-size: 0.75rem;
    color: var(--surface-txt-hint);
  }

  .mock {
    margin: 3.5rem auto 0;
    max-width: 720px;
    display: flex;
    border: 1px solid var(--surface-alt3);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-raised);
    text-align: left;
    background: var(--surface);
  }
  .mock-rail {
    width: 180px;
    flex-shrink: 0;
    background: var(--surface-alt1);
    border-right: 1px solid var(--surface-alt2);
    padding: 0.6rem;
  }
  .mock-rail-label {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--surface-txt-hint);
    margin: 0.3rem 0.4rem 0.6rem;
  }
  .mock-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--surface-txt-hint);
  }
  .mock-row.is-active {
    background: var(--surface-alt3);
    color: var(--surface-txt);
    font-weight: 500;
  }
  .mock-row .count {
    margin-left: auto;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.65rem;
    color: var(--surface-txt-hint);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .mock-main {
    flex: 1;
    min-width: 0;
  }
  .mock-topbar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--surface-alt2);
    font-size: 0.85rem;
  }
  .mock-topbar .count {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--surface-txt-hint);
  }
  .mock-kbd {
    margin-left: auto;
    border: 1px solid var(--surface-alt3);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.65rem;
    color: var(--surface-txt-hint);
  }
  .mock-tab {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--surface-alt2);
    font-size: 0.8rem;
  }
  .mock-tab:last-child {
    border-bottom: none;
  }
  .favicon {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: var(--surface-alt3);
    font-size: 0.6rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .tab-title {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tab-domain {
    color: var(--surface-txt-hint);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  section {
    padding: 5.5rem 0;
  }
  .spotlights,
  .how,
  .faq {
    text-align: center;
  }
  .spotlights h2,
  .how h2,
  .faq h2,
  .cta h2 {
    font-size: 1.9rem;
  }
  .section-lede {
    max-width: 50ch;
    margin: 0.75rem auto 0;
    color: var(--surface-txt-hint);
  }

  .feature-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    text-align: left;
  }
  .feature-card {
    background: var(--surface-alt1);
    border: 1px solid var(--surface-alt2);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .feature-card h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }
  .feature-card p {
    margin: 0;
    color: var(--surface-txt-hint);
    font-size: 0.9rem;
  }

  .btn-sm {
    padding: 0.35rem 0.7rem;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .spotlight-list {
    margin: 2.5rem 0 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .spotlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    text-align: left;
  }
  .spotlight:nth-child(even) .spotlight-text {
    order: 2;
  }
  .spotlight-text h3 {
    font-size: 1.3rem;
    margin: 0.5rem 0 0.5rem;
  }
  .spotlight-text p {
    margin: 0;
    color: var(--surface-txt-hint);
  }
  .spotlight-visual {
    background: var(--surface-alt1);
    border: 1px solid var(--surface-alt2);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1.25rem;
  }

  .restore-chip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .restore-chip-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .restore-chip .hint {
    font-size: 0.8rem;
    color: var(--surface-txt-hint);
  }

  .native-group-chip {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #0b0d12;
  }
  .native-group-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0.75rem 0 0 0.9rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--surface-alt3);
  }
  .mini-tab {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    color: var(--surface-txt-hint);
  }
  .native-group .hint {
    display: block;
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--surface-txt-hint);
  }

  .palette-input {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--surface-alt2);
  }
  .palette-placeholder {
    color: var(--surface-txt-hint);
    font-size: 0.85rem;
  }
  .palette-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.3rem;
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--surface-txt-hint);
  }
  .palette-row.is-active {
    background: var(--surface-alt3);
    color: var(--surface-txt);
  }

  .faq-list {
    max-width: 640px;
    margin: 2rem auto 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .faq-item {
    background: var(--surface-alt1);
    border: 1px solid var(--surface-alt2);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 500;
  }
  .faq-item summary::marker {
    color: var(--surface-txt-hint);
  }
  .faq-item p {
    margin: 0.75rem 0 0;
    color: var(--surface-txt-hint);
    font-size: 0.9rem;
  }

  .steps {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: left;
  }
  .step-n {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: var(--accent-alt1);
    font-size: 0.85rem;
  }
  .step h3 {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }
  .step p {
    margin: 0.4rem 0 0;
    color: var(--surface-txt-hint);
    font-size: 0.9rem;
  }

  .cta {
    text-align: center;
  }
  .cta .btn {
    margin-top: 1.5rem;
  }

  @media (max-width: 720px) {
    .feature-grid,
    .steps {
      grid-template-columns: 1fr;
    }
    .mock {
      flex-direction: column;
    }
    .mock-rail {
      width: auto;
      border-right: none;
      border-bottom: 1px solid var(--surface-alt2);
    }
    .spotlight {
      grid-template-columns: 1fr;
    }
    .spotlight:nth-child(even) .spotlight-text {
      order: initial;
    }
  }
</style>
